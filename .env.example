# Copy this file to .env and fill in your values.
#
# Only set the secrets for providers you actually use.
# Leave unused ones blank or delete them.

# Linear (required when source.adapter = linear)
LINEAR_API_KEY=

# Jira (required when source.adapter = jira)
JIRA_URL=
JIRA_EMAIL=
JIRA_TOKEN=

# Notion (required when source.adapter = notion)
NOTION_TOKEN=

# GitHub: no env vars needed — uses gh CLI auth.
# Run: gh auth login

# Ollama (future — ADR-003)
# OLLAMA_HOST=http://localhost:11434
