{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "feature-marker capability manifest",
  "type": "object",
  "required": ["version", "runtimes", "modes"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer" },
    "runtimes": {
      "type": "object",
      "required": ["claude", "codex", "gemini"],
      "additionalProperties": false,
      "properties": {
        "claude": { "$ref": "#/$defs/runtime" },
        "codex": { "$ref": "#/$defs/runtime" },
        "gemini": { "$ref": "#/$defs/runtime" }
      }
    },
    "modes": {
      "type": "object",
      "required": ["full", "tasks-only", "test-only", "prd-only"],
      "additionalProperties": {
        "type": "array",
        "items": { "enum": ["plan", "implement", "test", "branch"] }
      }
    }
  },
  "$defs": {
    "runtime": {
      "type": "object",
      "required": ["command", "required", "optional"],
      "additionalProperties": false,
      "properties": {
        "command": { "type": "string" },
        "required": { "type": "array", "items": { "type": "string" } },
        "optional": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
