{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "feature-marker checkpoint",
  "type": "object",
  "required": ["version", "slug", "mode", "runtime", "status", "current_phase", "worktree_path", "branch", "phases"],
  "additionalProperties": true,
  "properties": {
    "version": { "type": "string" },
    "slug": { "type": "string" },
    "mode": { "enum": ["full", "tasks-only", "test-only", "prd-only"] },
    "runtime": { "enum": ["claude", "codex", "gemini"] },
    "status": { "enum": ["pending", "running", "planned", "completed", "failed"] },
    "current_phase": { "enum": ["plan", "implement", "test", "branch"] },
    "root_path": { "type": "string" },
    "artifacts_path": { "type": "string" },
    "worktree_path": { "type": ["string", "null"] },
    "branch": { "type": ["string", "null"] },
    "phases": { "type": "object" },
    "platform_context": { "type": ["object", "null"] },
    "branch_handoff": { "type": ["object", "null"] },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" }
  }
}
