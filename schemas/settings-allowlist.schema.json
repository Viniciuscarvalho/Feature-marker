{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Claude settings.json allowlist (ADR-011)",
  "type": "object",
  "required": [
    "permissions"
  ],
  "properties": {
    "permissions": {
      "type": "object",
      "required": [
        "allow",
        "deny"
      ],
      "properties": {
        "allow": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Advisory allowlist (enforced in supervised/checkpoint modes; advisory under bypassPermissions)"
        },
        "deny": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Deny list enforced by Claude pre-tool-use hooks regardless of permission mode"
        }
      }
    }
  }
}
